DATABASE_URL=postgresql+psycopg2://agentconnect:agentconnect@localhost:5432/agentconnect
REDIS_URL=redis://localhost:6379/0
GOOGLE_API_KEY=
# Alternatively, set GEMINI_API_KEY.
EMBEDDING_MODEL=gemini-embedding-001
RERANK_MODEL=gemini-2.5-flash
ROUTING_THRESHOLD=0.68
ROUTING_CANDIDATES=30
WEBHOOK_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
WEBHOOK_TIMEOUT_SECONDS=8
RATE_LIMIT_REQUESTS=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
